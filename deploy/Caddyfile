# Caddyfile —— 本机回环 Web 入口（免 root，用户态运行）
# 作用：serve 前端 dist（含 SPA 回退）+ 把 /api 反代到本机 uvicorn:8000。
# 只监听 127.0.0.1:8088，绝不对外；对外由云机 nginx + frp 隧道负责。
{
	admin off
	auto_https off
}

http://:8088 {
	bind 127.0.0.1

	encode gzip

	# API 走本机后端
	@api path /api/*
	handle @api {
		reverse_proxy 127.0.0.1:8000
	}

	# 其余给静态 SPA；深链回退到 index.html（react-router history 模式）
	handle {
		root * <PROJECT_ROOT>/web/frontend/dist
		try_files {path} {path}/ /index.html
		file_server
	}
}
